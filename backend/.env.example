# Copy this file to backend/.env and fill in what you have. Nothing here is needed to run the keyless replay demo.
# NEVER commit your real .env (it is git-ignored).

# --- The model that runs the agent and reads photos (an OpenAI-compatible chat endpoint) ---
LLM_API_KEY=
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open-1026

# --- Web search for businesses that are not on Konsyer (Meta Model API) ---
# mock = fictional "Sample ..." leads, no key needed (default). meta = real web search. none = off.
DISCOVERY_PROVIDER=mock
META_API_KEY=
# META_API_BASE=https://api.meta.ai/v1
# META_SEARCH_MODEL=muse-spark-1.3

# --- Admin console (open /#/admin in the app). Any string works in the sandbox; use a long random one anywhere else.
KONSYER_ADMIN_KEY=demo-admin-key

# --- Optional ---
# KONSYER_DB=konsyer.db            # where the SQLite database lives
# KONSYER_REPLAY=demo/trace.jsonl  # answer model calls from a recording (no model key needed)
# DISCOVERY_SHOW_PHONES=0          # hide phone numbers found on the web
# AGENT_REASONING_EFFORT=low
